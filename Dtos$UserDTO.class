<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Meus Lances - Bidding System</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        :root { --primary: #0f172a; --accent: #2563eb; --bg: #f8fafc; --surface: #ffffff; --text: #334155; --border: #e2e8f0; --radius: 8px; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }
        .sidebar { width: 250px; background: var(--primary); color: white; padding: 1.5rem; }
        .sidebar h2 { font-size: 1.2rem; margin-bottom: 2rem; }
        .sidebar a { display: block; color: #cbd5e1; text-decoration: none; padding: 0.75rem; margin-bottom: 0.5rem; border-radius: var(--radius); }
        .sidebar a:hover, .sidebar a.active { background: #1e293b; color: white; }
        .main { flex: 1; display: flex; flex-direction: column; }
        .navbar { height: 60px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: flex-end; padding: 0 2rem; }
        .content { padding: 2rem; max-width: 1200px; margin: 0 auto; width: 100%; }
        
        .table-container { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-top: 1.5rem;}
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { background: #f1f5f9; padding: 1rem; font-size: 0.85rem; color: #64748b; font-weight: 600; border-bottom: 1px solid var(--border); }
        td { padding: 1rem; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>🔨 Bidding System</h2>
        <a th:href="@{/editais}">📄 Editais Abertos</a>
        <a th:href="@{/editais/novo}">➕ Novo Edital</a>
        <a th:href="@{/lances/meus}" class="active">💰 Meus Lances</a>
    </div>
    <div class="main">
        <div class="navbar"><a th:href="@{/login}" style="color: #ef4444; text-decoration: none; font-weight: 500;">Sair</a></div>
        <div class="content">
            <h1 style="color: var(--primary);">Minhas Propostas</h1>
            <p style="color: #64748b; font-size: 0.9rem; margin-top: 0.25rem;">Acompanhe os lances que você enviou.</p>

            <div class="table-container">
                <table>
                    <thead>
                        <tr><th>Processo</th><th>Item</th><th>Meu Lance</th><th>Data/Hora</th></tr>
                    </thead>
                    <tbody>
                        <tr th:each="lance : ${meusLances}">
                            <td style="font-weight: 600;" th:text="${lance.editalNumero}">PE-001/2026</td>
                            <td th:text="${lance.itemDescricao}">Equipamentos</td>
                            <td style="color: var(--accent); font-weight: 600;" th:text="'R$ ' + ${lance.valor}">R$ 4.600,00</td>
                            <td th:text="${#temporals.format(lance.dataLance, 'dd/MM/yyyy HH:mm')}">10/10/2026 14:15</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>