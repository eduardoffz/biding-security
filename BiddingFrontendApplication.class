* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }
.container { max-width: 900px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
h2 { margin-bottom: 20px; color: #2c3e50; }
.header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.form-group { margin-bottom: 15px; }
.form-group label { display: block; margin-bottom: 5px; font-weight: bold; }



input, select { width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
button, .btn-novo { background: #2c3e50; color: #fff; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-size: 14px; text-decoration: none; }
button:hover, .btn-novo:hover { background: #1a252f; }
.btn-link { color: #2980b9; text-decoration: none; }
.alert { padding: 10px 15px; border-radius: 4px; margin-bottom: 15px; }
.alert-error { background: #fde8e8; color: #c0392b; border: 1px solid #f5c6cb; }




.alert-info { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
.filtros { display: flex; gap: 15px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
.filtros a { color: #2980b9; text-decoration: none; padding: 6px 12px; border-radius: 4px; }
.filtros a.active { background: #2c3e50; color: #fff; }




table { width: 100%; border-collapse: collapse; }
th, td { padding: 10px 12px; border: 1px solid #ddd; text-align: left; font-size: 14px; }
th { background: #2c3e50; color: #fff; }

tr:nth-child(even) { background: #f9f9f9; }
.badge-aberto { background: #d4edda; color: #155724; padding: 3px 8px; border-radius: 10px; font-size: 12px; }
.badge-fechado { background: #f8d7da; color: #721c24; padding: 3px 8px; border-radius: 10px; font-size: 12px; }
p { margin-top: 15px; font-size: 14px; }
