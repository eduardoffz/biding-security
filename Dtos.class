<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Bidding System</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        :root { --primary: #0f172a; --accent: #2563eb; --bg: #f8fafc; --surface: #ffffff; --text: #334155; --border: #e2e8f0; --radius: 8px; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background: var(--bg); color: var(--text); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1rem; }
        .auth-card { background: var(--surface); padding: 2.5rem; border-radius: var(--radius); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border: 1px solid var(--border); width: 100%; max-width: 420px; }
        .auth-card h2 { font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--primary); }
        .form-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
        label { font-size: 0.85rem; font-weight: 600; color: var(--primary); }
        input, select { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); outline: none; }
        input:focus, select:focus { border-color: var(--accent); }
        .btn { padding: 0.75rem; background: var(--accent); color: white; border: none; border-radius: var(--radius); font-weight: 600; cursor: pointer; width: 100%; margin-top: 1rem; }
        .btn:hover { background: #1d4ed8; }
        .alert { background: #fef2f2; color: #ef4444; padding: 0.75rem; border-radius: var(--radius); margin-bottom: 1rem; font-size: 0.9rem; border: 1px solid #ef4444; word-wrap: break-word; }
        a { color: var(--accent); text-decoration: none; font-weight: 500; }
    </style>
</head>
<body>
    <div class="auth-card">
        <h2>Criar Conta</h2>
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 2rem;">Cadastre-se para participar de licitações.</p>
        
        <div th:if="${erro != null}" class="alert">
            <span th:text="${new com.fasterxml.jackson.databind.ObjectMapper().readTree(erro).get('message').asText()}">
                Erro de cadastro padrão.
            </span>
        </div>

        <form method="post" th:action="@{/register}">
            <div class="form-group">
                <label>Nome / Razão Social</label>
                <input type="text" name="nome" placeholder="Empresa LTDA" required/>
            </div>
            <div class="form-group">
                <label>Email Corporativo</label>
                <input type="email" name="email" placeholder="contato@empresa.com" required/>
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="senha" placeholder="••••••••" required/>
            </div>
            <div class="form-group">
                <label>Perfil</label>
                <select name="role">
                    <option value="COMPRADOR">Comprador</option>
                    <option value="FORNECEDOR">Fornecedor</option>
                </select>
            </div>
            <button type="submit" class="btn">Cadastrar</button>
        </form>
         <p style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">Já tem conta? <a th:href="@{/login}">Entrar</a></p>
    </div>
</body>
</html>