<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head th:fragment="html_head(titulo)">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}">Bidding System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/all.min.css" rel="stylesheet">
    
    <style>
        /* Ajuste fino para o conceito de LEGO */
        body { background-color: #f8f9fa; }
        .auth-card { border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    </style>
</head>

<body>

    <header th:fragment="topo">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" href="#">🔨 BIDDING SYSTEM</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" th:href="@{/login}">Login</a></li>
                        <li class="nav-item"><a class="nav-link" th:href="@{/register}">Cadastrar</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <footer th:fragment="rodape" class="mt-5 py-3 border-top text-center text-muted">
        <div class="container">
            <small>&copy; 2024 Bidding System - SENAI Manutenção Única</small>
        </div>
    </footer>

</body>
</html>